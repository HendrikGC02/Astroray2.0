diff --git a/src/device/cpu/cpu_device.cpp b/src/device/cpu/cpu_device.cpp
index acec314..863e808 100644
--- a/src/device/cpu/cpu_device.cpp
+++ b/src/device/cpu/cpu_device.cpp
@@ -58,7 +58,7 @@ const ar::KernelGlobals& CpuDevice::globals() const {
