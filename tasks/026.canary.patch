@@ -68,7 +68,7 @@ void CpuDevice::launch(ar::Stage stage, uint32_t /*grid*/) {
   const ar::StepEntry& step = kg.step_table->stage[i];
   // The segment is the device-resident step entry's count; the host's grid value only
