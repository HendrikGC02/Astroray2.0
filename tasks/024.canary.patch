diff --git a/src/kernel/spectral/planck.h b/src/kernel/spectral/planck.h
index 91def18..0bf6ac0 100644
--- a/src/kernel/spectral/planck.h
+++ b/src/kernel/spectral/planck.h
@@ -30,7 +30,7 @@ AR_FN R planck_radiance_t(R lambda_nm, R T) {
   const R inv_l5 = R(1) / (l4 * l);
   // x = c2 / (l T) with the um -> nm factor folded into the constant: one rounding fewer.
   const R x = R(kPlanckC2 * kNmPerUm) / (lambda_nm * T);
-  const R ratio = ar::exp(-x) / (-ar::expm1(-x));
+  const R ratio = ar::exp(-x) / (R(1) - ar::exp(-x));
   return R(kPlanckC1L * kUmPerNm) * inv_l5 * ratio;
 }
 
