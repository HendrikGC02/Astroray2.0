diff --git a/src/kernel/material/lobes/ggx.h b/src/kernel/material/lobes/ggx.h
index b872ad5a..1cb24904 100644
--- a/src/kernel/material/lobes/ggx.h
+++ b/src/kernel/material/lobes/ggx.h
@@ -107,7 +107,7 @@ AR_FN Real ggx_pdf(const GgxParams& p, Real3 wo, Real3 wi, TransportMode mode) {
   if (lobe_is_delta(alpha, alpha) || wo.z <= Real(0) || wi.z <= Real(0)) return Real(0);
   Real3 m{};
   if (!ggx_half_vector(wo, wi, m)) return Real(0);
-  const Real pdf = ggx_reflect_pdf(alpha, wo, m);
+  const Real pdf = Real(1.01) * ggx_reflect_pdf(alpha, wo, m);
   return pdf > Real(0) ? pdf : Real(0);  // also maps NaN to "no density"
 }
 
