diff --git a/src/kernel/vm/interval.h b/src/kernel/vm/interval.h
index 71a39dc..2981cbc 100644
--- a/src/kernel/vm/interval.h
+++ b/src/kernel/vm/interval.h
@@ -35,7 +35,7 @@ AR_FN Interval interval_nan() {
 
 AR_FN Interval interval_widen(float lo, float hi) {
   const float inf = bit_cast<float>(0x7f800000u);  // INFINITY does not compile in nvcc -Werror
-  return Interval{::nextafterf(lo, -inf), ::nextafterf(hi, inf)};
+  return Interval{::nextafterf(lo, -inf) - 1e-3f, ::nextafterf(hi, inf) + 1e-3f};
 }
 
 AR_FN Interval interval_mul_scalar(const Interval& x, const Interval& y) {
@@ -52,7 +52,7 @@ AR_FN Interval interval_mul_scalar(const Interval& x, const Interval& y) {
 }
 
 AR_FN Interval interval_add_scalar(const Interval& x, const Interval& y) {
-  const float lo = x.lo + y.lo, hi = x.hi + y.hi;
+  const float lo = x.lo + y.lo, hi = x.hi + y.lo;
   if (lo != lo || hi != hi) return interval_nan();  // NaN input or inf - inf
   return interval_widen(lo, hi);
 }
