# Script mode: cmake -DOUT=<file> -DGIT=<git> -DSRC=<source dir> -DVERSION=<v>
#   -DBUILD_TYPE=<t> -P buildinfo.cmake
# Writes build_info.cpp only when its content changes, so a commit that moves
# nothing but the sha relinks the DLL and nothing else (0009 d5).
foreach(var OUT GIT SRC VERSION BUILD_TYPE)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "buildinfo.cmake: ${var} not set")
  endif()
endforeach()

execute_process(COMMAND ${GIT} rev-parse HEAD WORKING_DIRECTORY ${SRC}
  OUTPUT_VARIABLE sha OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR NOT sha MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "buildinfo.cmake: git rev-parse HEAD failed in ${SRC}")
endif()
# --no-optional-locks: status must not rewrite the index this command depends on.
execute_process(COMMAND ${GIT} --no-optional-locks status --porcelain --untracked-files=no
  WORKING_DIRECTORY ${SRC} OUTPUT_VARIABLE changes RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "buildinfo.cmake: git status failed in ${SRC}")
endif()
if(changes STREQUAL "")
  set(dirty 0)
else()
  set(dirty 1)
endif()

# Toolkits that are not built in yet read "none" (0009 d5).
set(content "// Generated by cmake/buildinfo.cmake; never edited.
#include \"host/build_info.h\"
namespace astroray {
const BuildInfo kBuildInfo = {\"${VERSION}\", \"${sha}\", ${dirty}, \"none\", \"none\", \"none\", \"none\", \"${BUILD_TYPE}\"};
}  // namespace astroray
")
set(old "")
if(EXISTS ${OUT})
  file(READ ${OUT} old)
endif()
if(NOT old STREQUAL content)
  file(WRITE ${OUT} "${content}")
endif()
