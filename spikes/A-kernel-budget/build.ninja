cudalib = C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.8/lib/x64
cudainc = C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.8/include
rule nvcc
  command = cmd /c "nvcc -gencode arch=compute_120,code=sm_120 -O3 -std=c++17 -Xcompiler /MD -Iinclude -Isrc $flags -Xptxas -v -c $in -o $out > $out.log 2>&1"
  description = NVCC $out
rule cl
  command = cl /nologo /O2 /EHsc /std:c++17 /MD -Iinclude -I"$cudainc" -c $in /Fo$out
  description = CL $out
rule link
  command = link /nologo /OUT:$out $in /LIBPATH:"$cudalib" cudart.lib
  description = LINK $out
build out/obj/base_fused.obj: nvcc src/k_fused.cu | include/kl.h include/material.h include/lobes.h include/stages.h include/gpu_scene.h src/kcommon.h
  flags = -DKL_VARIANT=base -DKL_WIDTH=4 -DKL_LB=0 -DKL_LB_MIN=0 -DKL_NOINLINE_LOBES=0 -DKL_MAT_BYPTR=0
build out/obj/base_bsdf.obj: nvcc src/k_bsdf.cu | include/kl.h include/material.h include/lobes.h include/stages.h include/gpu_scene.h src/kcommon.h
  flags = -DKL_VARIANT=base -DKL_WIDTH=4 -DKL_LB=0 -DKL_LB_MIN=0 -DKL_NOINLINE_LOBES=0 -DKL_MAT_BYPTR=0
