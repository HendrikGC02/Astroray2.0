// SPDX-License-Identifier: Apache-2.0
// The one opcode table (0005 item 30). Included with AR_OP defined; never
// compiled alone. tools/opsgen.py parses it too, so keep one row per line.
//
//   AR_OP(NAME, arity, operand_types, result_type, cost_class, interval_rule,
//         volume_reachable, test_only, foldable)
//
// arity: register inputs. operand_types: the operands in a, b, c byte order and
// then the immediate words, '+' separated, "" for none. Tokens (the bytes the
// interpreter reads, 0005 item 31): reg = a register byte; imm = an immediate
// word; uvset = UV set index in byte b; lift = SpectrumSemantic in byte c;
// regrgbs = byte a, four registers: colour in a..a+2, strength in a+3;
// slotimm = immediate word, slot id in bits 0-7 (RecordSlot: 0-23 scalar, 24-32
// spectral, 33-36 frames) and pre-lifted flag in bit 8; jmpoff = immediate word,
// the forward offset counted in words from the JMP word.
// result_type: f32, f32x3, spec or "" (item 31). cost_class: CHEAP, MEM
// or TEX. interval_rule: the function interval_<name> that bounds the op over a
// box (0006 D7) or NONE_SURFACE_ONLY, allowed only when volume_reachable is
// false. test_only ops compile only with AR_GATE_HOOKS.
// foldable (true or false, always the last field): the host compiler may evaluate the op at
// compile time when every input is a constant (0005 item 35). True only when ALL hold: the result
// is a pure function of the input registers and immediates, so it reads no ShadeContext, texture,
// wavelength or other per-path state; the result type is f32 or f32x3 (not spec, not empty); the
// op is not test_only; and the operand tokens are only reg and imm, so the fold test can rebuild
// the instruction from the row. A foldable row also needs a case in compiler.cpp fold() that
// calls its ar::op_* function (without one the compiler reports an internal error), and
// `compiler_fold/*` then compares fold() with the interpreter on 1e4 inputs per foldable row.
// tools/opsgen.py refuses a foldable row that breaks the rules above.
// Row order is the opcode number; append, never reorder.
// Ref: docs/decisions/0005-material-model.md items 30, 31; 0006 D7.
AR_OP(END,             0, "",                 "",      CHEAP, NONE_SURFACE_ONLY,      false, false, false)
AR_OP(JMP,             0, "jmpoff",           "",      CHEAP, NONE_SURFACE_ONLY,      false, false, false)
AR_OP(CONST_F32,       0, "reg+imm",          "f32",   CHEAP, interval_const_f32,     true,  false, true)
AR_OP(CONST_F32X3,     0, "reg+imm+imm+imm",  "f32x3", CHEAP, interval_const_f32x3,   true,  false, true)
AR_OP(LOAD_CTX_UV,     0, "reg+uvset",        "f32x3", CHEAP, NONE_SURFACE_ONLY,      false, false, false)
AR_OP(LOAD_CTX_P,      0, "reg",              "f32x3", CHEAP, interval_load_ctx_p,    true,  false, false)
AR_OP(MUL_F32,         2, "reg+reg+reg",      "f32",   CHEAP, interval_mul_f32,       true,  false, true)
AR_OP(MUL_F32X3,       2, "reg+reg+reg",      "f32x3", CHEAP, interval_mul_f32x3,     true,  false, true)
AR_OP(MUL_F32X3_F32,   2, "reg+reg+reg",      "f32x3", CHEAP, interval_mul_f32x3_f32, true,  false, true)
AR_OP(ADD_F32X3,       2, "reg+reg+reg",      "f32x3", CHEAP, interval_add_f32x3,     true,  false, true)
AR_OP(TEX_IMAGE,       1, "reg+reg+imm+imm",  "f32x3", TEX,   NONE_SURFACE_ONLY,      false, false, false)
AR_OP(STORE_SLOT,      1, "reg+slotimm",      "",      CHEAP, NONE_SURFACE_ONLY,      false, false, false)
AR_OP(RGB_LIFT,        1, "reg+reg+lift",     "spec",  CHEAP, NONE_SURFACE_ONLY,      false, false, false)
AR_OP(EMIT_LE,         1, "regrgbs",          "",      CHEAP, NONE_SURFACE_ONLY,      false, false, false)
AR_OP(UNSUPPORTED,     0, "imm",              "",      CHEAP, NONE_SURFACE_ONLY,      false, false, false)
AR_OP(TEST_INJECT_NAN, 0, "reg",              "f32",   CHEAP, NONE_SURFACE_ONLY,      false, true, false)
AR_OP(BLACKBODY,       0, "reg+imm+imm",      "spec",  CHEAP, NONE_SURFACE_ONLY,      false, false, false)
AR_OP(CAUCHY_ABBE,     0, "reg+imm+imm+imm",  "spec",  CHEAP, NONE_SURFACE_ONLY,      false, false, false)
AR_OP(CHANNEL_F32X3,   1, "reg+reg+imm",      "f32",   CHEAP, NONE_SURFACE_ONLY,      false, false, true)
AR_OP(BRANCH_MIX,      2, "reg+reg+jmpoff",   "",      CHEAP, NONE_SURFACE_ONLY,      false, false, false)
AR_OP(ADD_F32,         2, "reg+reg+reg",      "f32",   CHEAP, NONE_SURFACE_ONLY,      false, false, true)
AR_OP(SUB_F32,         2, "reg+reg+reg",      "f32",   CHEAP, NONE_SURFACE_ONLY,      false, false, true)
